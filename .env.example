APP_NAME="Smart Mobility Backend"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./smart_mobility.db
SQLITE_FOREIGN_KEYS=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false
# Optional fixed clock for a repeatable demo. Restart without it for wall-clock time.
# DEMO_CLOCK_UTC=2026-11-16T02:00:00Z
# Demo freshness assumption. Set the same fixed clock for seed and server when recording.
BATTERY_FRESH_MINUTES=5
# Keep seeded simulated battery readings fresh in wall-clock demos; 0 disables.
DEMO_TELEMETRY_SECONDS=60
# Demo parking and charging policy
PARKING_NO_SHOW_MINUTES=10
CHARGING_DURATION_MINUTES=20
CHARGING_TARGET_PCT=80
OPERATIONAL_TICK_SECONDS=5
# Version demo-1: step interval and synthetic baseline rental arrivals per run.
SIMULATION_STEP_MINUTES=5
SIMULATION_BASELINE_RENTAL_COUNT=2
